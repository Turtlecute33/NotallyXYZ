<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing is backed up. The database must not be backed up while the SharedPreferences are excluded:
    'dataInPublicFolder', 'dataSchemaId', 'biometricLock', 'iv' and 'databaseEncryptionKey' all live in
    the preferences, so restoring the database without them makes the app look for the wrong file,
    re-run data migrations or try to open an encrypted database without its key. On top of that a live
    WAL database can only be backed up inconsistently, which restores as a corrupted database. The
    files hold attachments, internal backups and crash files.
    Users should use the app's own (ZIP) backups instead.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
