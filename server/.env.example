# Copy to .env and set a long random value: openssl rand -base64 32
# Anyone with this token can create an account. Remove it after your devices are set up.
SIGNUP_TOKEN=
# Optional: use the prebuilt image instead of building on this host (see README).
# NOTALLYXYZ_IMAGE=ghcr.io/turtlecute33/notallyxyz-server:1
# Only for the optional Caddy profile: public host name with DNS pointing to this server.
DOMAIN=notes.example.com
